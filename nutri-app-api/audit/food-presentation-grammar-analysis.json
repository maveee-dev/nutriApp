  "highImpactReusableRules": [
    {
      "rule": "state-and-preparation-as-variants",
      "rationale": "Keep raw/cooked/frozen/dried and grilled/roasted/fried descriptors secondary unless they define a distinct dish.",
      "evidenceCount": 4764,
      "percentage": 58.41,
      "examples": [
        "Abiyuch, raw",
        "Acerola juice, raw",
        "Acerola, (west indian cherry), raw",
        "Agave, cooked (Southwest)",
        "Agave, dried (Southwest)"
      ]
    },
    {
      "rule": "animal-plus-cut",
      "rationale": "Promote an animal and cut together, while leaving state and preparation descriptors in variantLabel.",
      "evidenceCount": 2548,
      "percentage": 31.24,
      "examples": [
        "APPLEBEE'S, 9 oz house sirloin steak",
        "APPLEBEE'S, chicken tenders platter",
        "APPLEBEE'S, chicken tenders, from kids' menu",
        "ARBY'S, roast beef sandwich, classic",
        "BANQUET, Salisbury Steak With Gravy, family size, frozen, unprepared"
      ]
    },
    {
      "rule": "beverage-type-first",
      "rationale": "Promote the beverage type or product instead of Alcoholic Beverage or Beverages as the title.",
      "evidenceCount": 846,
      "percentage": 10.37,
      "examples": [
        "Acerola juice, raw",
        "Alcoholic Beverage, wine, table, red, Barbera",
        "Alcoholic Beverage, wine, table, red, Burgundy",
        "Alcoholic Beverage, wine, table, red, Cabernet Franc",
        "Alcoholic Beverage, wine, table, red, Cabernet Sauvignon"
      ]
    },
    {
      "rule": "fish-species-first",
      "rationale": "Promote a fish species or seafood type instead of the generic Fish category.",
      "evidenceCount": 176,
      "percentage": 2.16,
