generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                    String                                  @id @default(uuid())
  email                                 String                                  @unique
  password                              String
  emailVerifiedAt                       DateTime?
  createdAt                             DateTime                                @default(now())
  updatedAt                             DateTime                                @updatedAt
  authOtpChallenges                     AuthOtpChallenge[]
  dailyNutritionLogs                    DailyNutritionLog[]
  diabetesCarbohydrateTarget            DiabetesCarbohydrateTarget?
  individualizedNutritionTargetEvidence IndividualizedNutritionTargetEvidence[]
  laboratoryReports                    LaboratoryReport[]
  laboratoryResults                     LaboratoryResult[]
  mealLogs                              MealLog[]
  mealTemplates                         MealTemplate[]                          @relation("MealTemplateOwner")
  approvedMealTemplateVersions          MealTemplateVersion[]                   @relation("MealTemplateVersionApprover")
  profile                               Profile?
  recipes                               Recipe[]                                @relation("RecipeOwner")
  approvedRecipeVersions                RecipeVersion[]                         @relation("RecipeVersionApprover")
  refreshTokenSessions                  RefreshTokenSession[]
  conditions                            UserCondition[]
  dialysisStatus                        UserDialysisStatus?
  allergies                              UserAllergy[]
  medications                            UserMedication[]
}

model AuthOtpChallenge {
  id             String         @id @default(uuid())
  userId         String
  purpose        AuthOtpPurpose
  codeHash       String
  expiresAt      DateTime
  sentAt         DateTime
  cooldownUntil  DateTime
  attemptCount   Int            @default(0)
  maxAttempts    Int
  consumedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([userId, purpose, expiresAt])
  @@index([userId, purpose, consumedAt])
}

model RefreshTokenSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@index([familyId])
}

model Profile {
  id            String         @id @default(uuid())
  age           Int?
  heightCm      Float?
  weightKg      Float?
  userId        String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sex           Sex?
  activityLevel ActivityLevel?
  nutritionGoal NutritionGoal?
  user          User           @relation(fields: [userId], references: [id])
}

model UserAllergy {
  id        String   @id @default(uuid())
  userId    String
  name      String
  reaction  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model UserMedication {
  id        String   @id @default(uuid())
  userId    String
  name      String
  dosage    String?
  frequency String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model DiabetesCarbohydrateTarget {
  id              String                       @id @default(uuid())
  userId          String                       @unique
  targetGrams     Decimal                      @db.Decimal(10, 2)
  approvalSource  DiabetesTargetApprovalSource
  sourceReference String?
  approvedAt      DateTime
  expiresAt       DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Immutable, approved numeric target evidence. New clinical target values are
/// represented by a new versioned row; existing rows are never updated.
model IndividualizedNutritionTargetEvidence {
  id              String                                @id @default(uuid())
  userId          String
  nutrientKey     String
  kind            NutritionTargetEvidenceKind
  targetValue     Decimal?                              @db.Decimal(12, 4)
  unit            String
  approvalSource  NutritionTargetEvidenceApprovalSource
  approvalStatus  NutritionTargetApprovalStatus          @default(APPROVED)
  sourceReference String?
  effectiveAt     DateTime
  approvedAt      DateTime
  expiresAt       DateTime?
  version         Int
  rangeMin        Decimal?                               @db.Decimal(12, 4)
  rangeMax        Decimal?                               @db.Decimal(12, 4)
  notes           String?
  createdAt       DateTime                              @default(now())
  user            User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nutrientKey, version], map: "IndividualizedNutritionTargetEvidence_userId_nutrientKey_versio")
  @@index([userId, nutrientKey, effectiveAt], map: "IndividualizedNutritionTargetEvidence_userId_nutrientKey_effect")
  @@index([userId, nutrientKey, expiresAt], map: "IndividualizedNutritionTargetEvidence_userId_nutrientKey_expire")
}

model Condition {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  users       UserCondition[]
}

model UserCondition {
  userId      String
  conditionId String
  createdAt   DateTime  @default(now())
  condition   Condition @relation(fields: [conditionId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([userId, conditionId])
}

model LaboratoryResult {
  id            String   @id @default(uuid())
  userId        String
  reportId      String?
  testCode      String
  testName      String?
  value         Decimal  @db.Decimal(12, 4)
  unit          String
  referenceLow  Decimal? @db.Decimal(12, 4)
  referenceHigh Decimal? @db.Decimal(12, 4)
  flag          String?
  collectedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  report        LaboratoryReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, collectedAt])
  @@index([userId, testCode, collectedAt])
  @@index([reportId])
}

/// Append-only laboratory report envelope. Results are stored separately so a
/// report can be reviewed and trended as a historical unit without changing
/// the legacy evidence rows consumed by existing policy resolution.
model LaboratoryReport {
  id         String             @id @default(uuid())
  userId     String
  reportDate DateTime           @db.Date
  source     String             @default("manual")
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  results    LaboratoryResult[]

  @@index([userId, reportDate])
}

model UserDialysisStatus {
  userId      String           @id
  status      DialysisStatus
  effectiveAt DateTime?
  reportedAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  modality    DialysisModality @default(UNKNOWN)
  frequency   String?
  schedule    String?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FoodCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  source      String   @default("manual")
  sourceId    String?
  foods       Food[]

  @@unique([source, sourceId])
  @@index([name])
}

model Food {
  id                String             @id @default(uuid())
  name              String
  description       String?
  categoryId        String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  source            String             @default("manual")
  sourceId          String?
  planningClass     FoodPlanningClass  @default(MEAL_ELIGIBLE)
  category          FoodCategory       @relation(fields: [categoryId], references: [id])
  nutrients         FoodNutrient[]
  presentation      FoodPresentation?
  mealTemplateSlots MealTemplateSlot[]
  recipeComponents  RecipeComponent[]
  servings          Serving[]
  dailyNutritionEntries DailyNutritionEntry[] @relation("DailyNutritionEntryFood")

  @@unique([source, sourceId])
  @@index([categoryId])
  @@index([name])
}

model Serving {
  id                String             @id @default(uuid())
  foodId            String
  name              String
  grams             Decimal            @db.Decimal(10, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mealItems         MealItem[]
  mealTemplateSlots MealTemplateSlot[]
  recipeComponents  RecipeComponent[]
  dailyNutritionEntries DailyNutritionEntry[] @relation("DailyNutritionEntryServing")
  food              Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, name])
  @@index([foodId])
}

model FoodPresentation {
  id                   String      @id @default(uuid())
  foodId               String      @unique
  displayNameOverride  String?
  variantLabelOverride String?
  searchPriority       Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  aliases              FoodAlias[]
  food                 Food        @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([searchPriority])
}

model FoodAlias {
  id                 String           @id @default(uuid())
  foodPresentationId String
  alias              String
  normalizedAlias    String
  priority           Int              @default(0)
  createdAt          DateTime         @default(now())
  presentation       FoodPresentation @relation(fields: [foodPresentationId], references: [id], onDelete: Cascade)

  @@unique([foodPresentationId, normalizedAlias])
  @@index([normalizedAlias])
}

model Recipe {
  id         String           @id @default(uuid())
  ownerId    String?
  visibility RecipeVisibility @default(PRIVATE)
  isFavorite Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  owner      User?            @relation("RecipeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions   RecipeVersion[]

  @@index([ownerId, visibility])
}

model RecipeVersion {
  id               String               @id @default(uuid())
  recipeId         String
  version          Int
  name             String
  description      String?
  preparationInstructions String?
  cuisine          String?
  mealTypes        MealType[]
  yieldServings    Decimal              @default(1) @db.Decimal(10, 2)
  sourceType       RecipeSourceType
  sourceName       String?
  sourceUrl        String?
  sourceReference  String?
  sourceVersion    String?
  approvalStatus   RecipeApprovalStatus @default(DRAFT)
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime             @default(now())
  templateSlots    MealTemplateSlot[]
  components       RecipeComponent[]
  dailyNutritionEntries DailyNutritionEntry[]
  approvedBy       User?                @relation("RecipeVersionApprover", fields: [approvedByUserId], references: [id])
  recipe           Recipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([approvalStatus])
}

model RecipeComponent {
  id              String              @id @default(uuid())
  recipeVersionId String
  foodId          String
  servingId       String?
  role            RecipeComponentRole
  quantity        Decimal             @db.Decimal(12, 4)
  unit            RecipeQuantityUnit
  displayOrder    Int
  notes           String?
  food            Food                @relation(fields: [foodId], references: [id])
  recipeVersion   RecipeVersion       @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  serving         Serving?            @relation(fields: [servingId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, displayOrder])
  @@index([foodId])
  @@index([recipeVersionId])
}

model MealTemplate {
  id         String                 @id @default(uuid())
  ownerId    String?
  visibility MealTemplateVisibility @default(PRIVATE)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  owner      User?                  @relation("MealTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions   MealTemplateVersion[]

  @@index([ownerId, visibility])
}

model MealTemplateVersion {
  id               String                     @id @default(uuid())
  mealTemplateId   String
  version          Int
  name             String
  description      String?
  cuisine          String?
  mealTypes        MealType[]                 @default([])
  sourceType       MealTemplateSourceType
  sourceName       String?
  sourceUrl        String?
  sourceReference  String?
  sourceVersion    String?
  approvalStatus   MealTemplateApprovalStatus @default(DRAFT)
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime                   @default(now())
  slots            MealTemplateSlot[]
  approvedBy       User?                      @relation("MealTemplateVersionApprover", fields: [approvedByUserId], references: [id])
  mealTemplate     MealTemplate               @relation(fields: [mealTemplateId], references: [id], onDelete: Cascade)

  @@unique([mealTemplateId, version])
  @@index([approvalStatus])
}

model MealTemplateSlot {
  id                         String               @id @default(uuid())
  mealTemplateVersionId      String
  role                       MealTemplateSlotRole
  kind                       MealTemplateSlotKind
  name                       String
  required                   Boolean              @default(true)
  allowCanonicalFoodFallback Boolean              @default(false)
  displayOrder               Int
  recipeVersionId            String?
  foodId                     String?
  servingId                  String?
  quantity                   Decimal?
  unit                       RecipeQuantityUnit?
  notes                      String?
  food                       Food?                @relation(fields: [foodId], references: [id], onDelete: Restrict)
  mealTemplateVersion        MealTemplateVersion  @relation(fields: [mealTemplateVersionId], references: [id], onDelete: Cascade)
  recipeVersion              RecipeVersion?       @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  serving                    Serving?             @relation(fields: [servingId], references: [id], onDelete: Restrict)

  @@unique([mealTemplateVersionId, displayOrder])
  @@index([mealTemplateVersionId])
  @@index([recipeVersionId])
  @@index([foodId])
}

model Nutrient {
  id          String         @id @default(uuid())
  name        String
  unit        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  source      String         @default("manual")
  sourceId    String?
  foods       FoodNutrient[]

  @@unique([source, sourceId])
  @@index([name])
}

model FoodNutrient {
  foodId     String
  nutrientId String
  amount     Decimal  @db.Decimal(10, 2)
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@id([foodId, nutrientId])
  @@index([foodId])
  @@index([nutrientId])
}

/// A user's day-level tracker aggregate. The date is stored as a UTC calendar
/// date, matching the existing daily nutrition analysis convention.
model DailyNutritionLog {
  id        String                 @id @default(uuid())
  userId    String
  date      DateTime               @db.Date
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   DailyNutritionEntry[]

  @@unique([userId, date])
  @@index([userId, date])
}

/// A tracker entry keeps canonical food/serving references and a name snapshot
/// for historical readability. Nutrient values are intentionally not copied;
/// totals are recalculated through the existing authoritative calculator.
model DailyNutritionEntry {
  id                String            @id @default(uuid())
  dailyLogId        String
  foodId            String?
  servingId         String?
  recipeId          String?
  recipeVersionId   String?
  servings          Decimal           @db.Decimal(10, 2)
  snapshotFoodName  String
  snapshotServingName String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dailyLog          DailyNutritionLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  food              Food?             @relation("DailyNutritionEntryFood", fields: [foodId], references: [id], onDelete: Restrict)
  serving           Serving?          @relation("DailyNutritionEntryServing", fields: [servingId], references: [id], onDelete: Restrict)
  recipeVersion     RecipeVersion?    @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)

  @@index([dailyLogId, createdAt])
  @@index([foodId])
  @@index([servingId])
  @@index([recipeId])
  @@index([recipeVersionId])
}

model MealLog {
  id         String     @id @default(uuid())
  userId     String
  mealType   MealType
  consumedAt DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      MealItem[]
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model MealItem {
  id                  String                       @id @default(uuid())
  mealLogId           String
  servingId           String
  quantity            Decimal                      @db.Decimal(10, 2)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  mealLog             MealLog                      @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  serving             Serving                      @relation(fields: [servingId], references: [id])
  evaluationSnapshots MealItemEvaluationSnapshot[]

  @@index([mealLogId])
  @@index([servingId])
}

model MealItemEvaluationSnapshot {
  id               String   @id @default(uuid())
  mealItemId       String
  score            Int
  coverage         Float
  payload          Json
  evaluatorVersion String
  policyVersion    String
  snapshotVersion  String
  evaluatedAt      DateTime
  createdAt        DateTime @default(now())
  mealItem         MealItem @relation(fields: [mealItemId], references: [id], onDelete: Cascade)

  @@index([mealItemId, evaluatedAt])
  @@index([evaluatorVersion, policyVersion])
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  MAINTENANCE
  WEIGHT_LOSS
  MUSCLE_GAIN
  WEIGHT_GAIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodPlanningClass {
  MEAL_ELIGIBLE
  BEVERAGE_ONLY
  CONDIMENT
  INGREDIENT
  ALCOHOL
  DESSERT
  SNACK
}

enum RecipeSourceType {
  OFFICIAL
  USER_CREATED
  COMMUNITY
  AI_IMPORTED
}

enum RecipeApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum RecipeVisibility {
  PRIVATE
  SHARED
}

enum RecipeComponentRole {
  MAIN_DISH
  STAPLE
  SIDE_DISH
  SOUP
  FRUIT
  DRINK
  INGREDIENT
}

enum RecipeQuantityUnit {
  SERVING
  GRAM
}

enum MealTemplateSourceType {
  OFFICIAL
  USER_CREATED
  COMMUNITY
  AI_IMPORTED
}

enum MealTemplateApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum MealTemplateVisibility {
  PRIVATE
  SHARED
}

enum MealTemplateSlotKind {
  FIXED
  PARAMETERIZED
}

enum MealTemplateSlotRole {
  MAIN_DISH
  STAPLE
  SIDE_DISH
  SOUP
  FRUIT
  DRINK
}

enum DialysisStatus {
  ACTIVE
  INACTIVE
}

enum DialysisModality {
  UNKNOWN
  HEMODIALYSIS
  PERITONEAL_DIALYSIS
  CONFLICTING
}

enum DiabetesTargetApprovalSource {
  USER_APPROVED
  CLINICIAN_APPROVED
}

enum NutritionTargetEvidenceApprovalSource {
  USER_APPROVED
  CLINICIAN_APPROVED
  SYSTEM_SUGGESTED
  IMPORTED
}

enum NutritionTargetEvidenceKind {
  UPPER_LIMIT
  LOWER_TARGET
  RANGE
}

enum NutritionTargetApprovalStatus {
  SUGGESTED
  APPROVED
  DISMISSED
}

enum AuthOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
