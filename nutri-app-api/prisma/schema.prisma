// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum DialysisStatus {
  ACTIVE
  INACTIVE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String

  profile    Profile?
  conditions UserCondition[]
  mealLogs   MealLog[]
  laboratoryResults LaboratoryResult[]
  dialysisStatus UserDialysisStatus?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Profile {
  id            String   @id @default(uuid())

  age           Int?
  sex           Sex?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Condition {
  id          String   @id @default(uuid())

  name        String   @unique
  description String?

  users       UserCondition[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model UserCondition {
  userId      String
  conditionId String

  user        User      @relation(fields: [userId], references: [id])
  condition   Condition @relation(fields: [conditionId], references: [id])

  createdAt   DateTime  @default(now())

  @@id([userId, conditionId])
}

model LaboratoryResult {
  id            String   @id @default(uuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  testCode      String
  value         Decimal  @db.Decimal(12, 4)
  unit          String
  referenceLow  Decimal? @db.Decimal(12, 4)
  referenceHigh Decimal? @db.Decimal(12, 4)
  collectedAt   DateTime

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, collectedAt])
  @@index([userId, testCode, collectedAt])
}

model UserDialysisStatus {
  userId      String         @id
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      DialysisStatus
  effectiveAt DateTime?
  reportedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FoodCategory {
  id          String   @id @default(uuid())

  source      String   @default("manual")
  sourceId    String?

  name        String
  description String?

  foods       Food[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([name])
}

model Food {
  id          String   @id @default(uuid())

  source      String   @default("manual")
  sourceId    String?

  name        String
  description String?

  categoryId  String
  category    FoodCategory @relation(fields: [categoryId], references: [id])

  servings    Serving[]
  nutrients   FoodNutrient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([name])
  @@unique([source, sourceId])
}

model Serving {
  id          String   @id @default(uuid())

  foodId      String
  food        Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  name        String
  grams       Decimal  @db.Decimal(10, 2)

  mealItems   MealItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([foodId, name])
  @@index([foodId])
}

model Nutrient {
  id          String   @id @default(uuid())

  source      String   @default("manual")
  sourceId    String?

  name        String
  unit        String
  description String?

  foods       FoodNutrient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([name])
}

model FoodNutrient {
  foodId      String
  nutrientId  String

  // Canonical nutrient amount per 100 grams of the food.
  // External imports must be normalized to this basis before persistence.
  amount      Decimal   @db.Decimal(10, 2)

  food         Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient     Nutrient  @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@id([foodId, nutrientId])

  @@index([foodId])
  @@index([nutrientId])
}

model MealLog {
  id          String    @id @default(uuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealType    MealType

  consumedAt  DateTime

  items       MealItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, consumedAt])
}

model MealItem {
  id          String    @id @default(uuid())

  mealLogId   String
  mealLog     MealLog   @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  servingId   String
  serving     Serving   @relation(fields: [servingId], references: [id])

  quantity    Decimal   @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([mealLogId])
  @@index([servingId])
}
